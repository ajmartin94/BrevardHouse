# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Port the app listens on.
PORT=4545

# Public base URL of the deployed app (no trailing slash). Only used by
# server/create-admin.js to build a sign-in link outside of a request context;
# the app itself derives links from the request host.
APP_URL=https://your-domain.example

# SMTP (Gmail). Leave SMTP_USER/SMTP_PASS blank to keep dev behavior: mail is only
# written to the outbox table (Admin panel) and logged to the console, nothing is sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Martin Brevard House <your-address@gmail.com>"
